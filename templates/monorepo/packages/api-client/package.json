    "gen": "orval --config orval.config.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.10.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.0.0",
    "orval": "^7.0.0",
    "typescript": "^5.5.0"
  }
}
